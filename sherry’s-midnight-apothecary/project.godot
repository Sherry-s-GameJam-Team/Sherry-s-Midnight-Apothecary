config_version=5

[application]

config/name="Sherry's Midnight Apothecary"
run/main_scene="res://app/app_root.tscn"
config/features=PackedStringArray("4.6")

[autoload]

DialogueManager="*uid://c3rodes2l3gxb"

[dialogue_manager]

runtime/balloon_path="res://night/dialogue/apothecary_balloon.tscn"
editor/advanced/custom_test_scene_path="res://night/dialogue/dialogue_test_scene.tscn"

[display]

window/size/viewport_width=1280
window/size/viewport_height=720
window/size/window_width_override=1280
window/size/window_height_override=720
window/stretch/mode="canvas_items"

[editor_plugins]

