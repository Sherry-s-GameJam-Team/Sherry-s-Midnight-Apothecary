[resource]
script = ExtResource("1_script")
id = &"herdsmans_loaf_bush"
display_name = "牧人块树"
english_name = "Herdsman’s Loaf-Bush"
description = "结有块果的乡野灌木，果实可煨熟充饥。味道微咸，带有植物脂肪的香气。"
lore = "草原牧童称它为‘大地母亲给没带干粮的人留下的面包’。块果表面的十字裂纹源自成熟时水分蒸发形成的张力痕迹；贫寒村户常将它围种在篱笆旁，作为秋季备用粮仓。"
icon = ExtResource("3_icon")
preview_texture = ExtResource("4_preview")
reference_canvas_size = Vector2i(4096, 4096)
production_layers = Array[ExtResource("2_layer_script")]([ExtResource("5_fruit"), ExtResource("6_foliage")])
base_value = 12
spectrum_start = 0.17
spectrum_end = 0.54
base_quality = 1.0
