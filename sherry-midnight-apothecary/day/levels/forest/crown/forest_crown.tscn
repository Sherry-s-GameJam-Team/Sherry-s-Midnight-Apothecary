[sub_resource type="Shader" id="Shader_gloomy_mood"]
code = "shader_type canvas_item;
uniform vec4 tint_color : source_color = vec4(0.06, 0.04, 0.12, 0.32);
uniform vec4 vignette_color : source_color = vec4(0.02, 0.01, 0.06, 0.65);
uniform float vignette_strength : hint_range(0.0, 1.0) = 0.55;
uniform float rain_mist_density : hint_range(0.0, 1.0) = 0.25;
void fragment(){
 vec2 uv = UV;
 float d = distance(uv, vec2(0.5, 0.45));
 float vig = smoothstep(0.3, 0.85, d) * vignette_strength;
 float mist = sin(uv.x * 6.0 + TIME * 0.8) * cos(uv.y * 4.0 - TIME * 0.5);
 float mist_val = (0.5 + mist * 0.5) * rain_mist_density;
 vec4 col = mix(tint_color, vignette_color, vig);
 col.a = clamp(col.a + mist_val * 0.15, 0.0, 1.0);
 COLOR = col;
}"

[sub_resource type="ShaderMaterial" id="Material_gloomy_mood"]
shader = SubResource("Shader_gloomy_mood")
shader_parameter/tint_color = Color(0.06, 0.04, 0.12, 0.32)
shader_parameter/vignette_color = Color(0.02, 0.01, 0.06, 0.65)
shader_parameter/vignette_strength = 0.55
shader_parameter/rain_mist_density = 0.25

