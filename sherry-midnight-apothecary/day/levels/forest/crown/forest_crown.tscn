[sub_resource type="Shader" id="Shader_shockwave"]
code = "shader_type canvas_item;
uniform vec2 center = vec2(0.5, 0.4);
uniform float radius : hint_range(0.0, 2.0) = 0.0;
uniform float width : hint_range(0.0, 0.2) = 0.04;
void fragment(){
 float d = distance(UV, center);
 float ring = smoothstep(radius - width, radius, d) - smoothstep(radius, radius + width, d);
 COLOR = vec4(0.85, 1.0, 0.95, ring * 0.85);
}"

