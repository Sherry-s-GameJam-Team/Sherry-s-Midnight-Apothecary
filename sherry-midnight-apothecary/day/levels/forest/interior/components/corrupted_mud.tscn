[sub_resource type="Shader" id="Shader_mud"]
code = "shader_type canvas_item;\nuniform vec4 dark_color : source_color = vec4(0.09, 0.035, 0.08, 1.0);\nuniform vec4 pulse_color : source_color = vec4(0.42, 0.08, 0.14, 1.0);\nuniform float cleanse_progress : hint_range(0.0, 1.0) = 0.0;\nvoid fragment(){\n vec2 uv=UV;\n float w=sin(uv.x*14.0+TIME*1.7)*sin(uv.y*9.0-TIME*1.1);\n float p=0.5+w*0.18;\n vec4 c=mix(dark_color,pulse_color,p);\n c.rgb=mix(c.rgb,vec3(0.55,0.85,0.78),cleanse_progress*0.7);\n c.a*=1.0-cleanse_progress*0.25;\n COLOR=c;\n}"

