[sub_resource type="Shader" id="Shader_stream"]
code = "shader_type canvas_item;
uniform float speed = 0.14;
void fragment(){ vec2 uv=UV; uv.y=fract(uv.y+TIME*speed); vec4 c=texture(TEXTURE,uv); float shimmer=0.94+0.06*sin((UV.y+TIME)*28.0); COLOR=vec4(c.rgb*shimmer,c.a); }"

