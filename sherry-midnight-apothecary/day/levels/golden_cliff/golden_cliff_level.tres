[resource]
script = ExtResource("1_level_data")
id = &"golden_cliff"
display_name = "烁金横崖"
disaster_name = "断衡之灾"
normal_description = "金黄色断层横亘南北，古老衡石维持着横崖间最后的通路。"
corrupted_description = "黄脉失衡，巨岩忽轻忽重；悬石升空，断崖正在自身重量下崩解。"
scene_description = "校准三座失控衡石机关，穿过崩塌与浮岩区，在横崖尽头重新稳定旅门。"
content_scene = ExtResource("2_scene")
default_entry_id = &"default"
native_ingredient_ids = Array[StringName]([&"drop_cliff_whistle_leaf", &"eyrie_nest_seed_ball", &"wind_cutter_rye", &"egg_climbers_honey_pot"])
