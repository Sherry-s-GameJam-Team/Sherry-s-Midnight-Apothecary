[ext_resource type="PackedScene" path="res://day/levels/cliff/cliff.tscn" id="2_scene"]

[resource]
script = ExtResource("1_level_data")
id = &"cliff"
display_name = "烁金断崖"
disaster_name = "鸣晶之灾"
normal_description = "高耸晶柱与灰白断崖交错，苍蓝群晶在长风中发出低沉回响。"
corrupted_description = "群晶失序，共鸣化作撕裂山脊的震波。"
