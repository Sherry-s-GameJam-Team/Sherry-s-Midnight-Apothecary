[resource]
script = ExtResource("1_level_data")
id = &"crimson_vale"
display_name = "赤染溪谷"
disaster_name = "赤染之灾"
normal_description = "赤红枫林环绕的静谧溪谷，微风吹拂着村落屋舍与丹心界门。"
corrupted_description = "枫脂失控，浊气侵染；丹心门崩裂，炽烈异象封锁了谷口。"
scene_description = "探索赤染之谷，穿过枫脂干燥坊与村落，修复丹心门。"
content_scene = ExtResource("2_scene")
default_entry_id = &"default"
native_ingredient_ids = Array[StringName]([&"maple_heart_dark_vein", &"maple_marrow_star_crystal", &"waystation_lantern_fruit"])
