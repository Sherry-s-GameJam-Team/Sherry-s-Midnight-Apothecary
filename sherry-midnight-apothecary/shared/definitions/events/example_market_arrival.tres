[gd_resource type="Resource" load_steps=8 format=3]

[ext_resource type="Script" path="res://shared/events/story_event_definition.gd" id="1_definition"]
[ext_resource type="Script" path="res://shared/events/story_event_trigger_spec.gd" id="2_trigger"]
[ext_resource type="Script" path="res://shared/events/story_event_condition.gd" id="3_condition"]
[ext_resource type="Script" path="res://shared/events/story_event_action.gd" id="4_action"]
[ext_resource type="Resource" path="res://night/dialogue/test.dialogue" id="5_dialogue"]

[sub_resource type="Resource" id="Trigger"]
script = ExtResource("2_trigger")
type = 1
runtime_mode = 1
level_id = &"market"

[sub_resource type="Resource" id="DayZero"]
script = ExtResource("3_condition")
minimum_day = 0
maximum_day = 0

[sub_resource type="Resource" id="NotShown"]
script = ExtResource("3_condition")
type = 2
key = &"example_market_arrival_shown"

[sub_resource type="Resource" id="ShownFlag"]
script = ExtResource("4_action")
key = &"example_market_arrival_shown"

[sub_resource type="Resource" id="HerbReward"]
script = ExtResource("4_action")
type = 3
key = &"herdsmans_loaf_bush"
amount = 1

[resource]
script = ExtResource("1_definition")
id = &"example_market_arrival"
priority = 10
trigger = SubResource("Trigger")
conditions = Array[ExtResource("3_condition")]([SubResource("DayZero"), SubResource("NotShown")])
dialogue_resource = ExtResource("5_dialogue")
actions = Array[ExtResource("4_action")]([SubResource("ShownFlag"), SubResource("HerbReward")])
