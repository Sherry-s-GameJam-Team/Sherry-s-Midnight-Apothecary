[sub_resource type="Resource" id="UnlockMaintenanceHatch"]
script = ExtResource("4_action")
key = &"lumen_street_fountain_maintenance_hatch_unlocked"

[sub_resource type="Resource" id="DailyTask"]
script = ExtResource("4_action")
