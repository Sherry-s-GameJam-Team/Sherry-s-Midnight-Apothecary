[gd_resource type="Resource" load_steps=9 format=3]

[ext_resource type="Script" path="res://shared/events/story_event_definition.gd" id="1_definition"]
[ext_resource type="Script" path="res://shared/events/story_event_trigger_spec.gd" id="2_trigger"]
[ext_resource type="Script" path="res://shared/events/story_event_condition.gd" id="3_condition"]
[ext_resource type="Script" path="res://shared/events/story_event_action.gd" id="4_action"]
[ext_resource type="Resource" path="res://day/levels/home/day_one_home_luca.dialogue" id="5_dialogue"]

[sub_resource type="Resource" id="Trigger"]
script = ExtResource("2_trigger")
type = 2
runtime_mode = 1
interaction_key = &"day_one_home_luca_departure"

[sub_resource type="Resource" id="FirstDay"]
script = ExtResource("3_condition")
minimum_day = 1
maximum_day = 1

[sub_resource type="Resource" id="BedroomDialogueComplete"]
script = ExtResource("3_condition")
type = 1
key = &"story_event_completed:day_one_bedroom_luca_urgent"

[sub_resource type="Resource" id="DailyTask"]
script = ExtResource("4_action")
type = 5
key = &"lumen_street_red_fountain"
task_title = "调查流明街广场的红色喷泉"

[resource]
script = ExtResource("1_definition")
id = &"day_one_home_luca_departure"
priority = 100
trigger = SubResource("Trigger")
conditions = Array[ExtResource("3_condition")]([SubResource("FirstDay"), SubResource("BedroomDialogueComplete")])
dialogue_resource = ExtResource("5_dialogue")
actions = Array[ExtResource("4_action")]([SubResource("DailyTask")])
