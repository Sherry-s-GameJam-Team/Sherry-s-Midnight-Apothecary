[resource]
script = ExtResource("1_script")
id = &"stardust_puffy_lion"
display_name = "星屑蒲公英"
english_name = "Stardust Puffy-Lion"
description = "冠毛泛着如星屑般的冷光，会朝光源缓慢偏转。“Puffy-Lion”是西欧民间对蒲公英的古老称呼，源自法语“狮子牙齿”的音译。"
lore = "这是一种被认为吸收了满月月光的植物。它的冠毛不随风飘散，而是会被光线吸引。在深夜，它看起来就像是从天空掉落并扎根的星光。"
icon = ExtResource("3_icon")
preview_texture = ExtResource("4_preview")
reference_canvas_size = Vector2i(4096, 4096)
production_layers = Array[ExtResource("2_layer_script")]([ExtResource("5_crown"), ExtResource("6_foliage")])
base_value = 18
spectrum_start = 0.43
spectrum_end = 0.63
base_quality = 1.1
base_concentration = 1.08
