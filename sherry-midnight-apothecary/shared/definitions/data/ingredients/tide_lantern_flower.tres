[resource]
script = ExtResource("1_ingredient")
id = &"tide_lantern_flower"
display_name = "潮灯花"
english_name = "Tide-Lantern Flower"
description = "花冠像一盏含着海雾的灯，能为药汤提供明亮、灵动的青色尾韵。"
lore = "潮灯花只在月光与潮声同时抵达礁洞时张开。旧时引航人会把干花挂在船舱里，祈求雾中仍能辨明归航。"
icon = ExtResource("4_icon")
preview_texture = ExtResource("5_preview")
reference_canvas_size = Vector2i(4096, 4096)
production_layers = Array[ExtResource("2_layer")]([SubResource("Layer_main")])
base_value = 19
spectrum_start = 0.675
spectrum_end = 0.705
base_quality = 1.1
base_concentration = 1.08
