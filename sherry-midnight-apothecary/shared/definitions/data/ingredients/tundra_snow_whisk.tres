[resource]
script = ExtResource("1_ingredient_script")
id = &"tundra_snow_whisk"
display_name = "冻原拂雪花"
english_name = "Tundra Snow-Whisk"
description = "雪白绒穗可浸酒析出微苦的抗寒成分，适合制作御寒药剂。"
lore = "雪山脚下居民会将数株绑成拂雪刷，用来扫去皮袄和靴子上的积雪；巡山守卫则饮用拂雪酒延缓手脚冻木。"
icon = ExtResource("4_icon")
preview_texture = ExtResource("5_preview")
reference_canvas_size = Vector2i(4096, 4096)
production_layers = Array[ExtResource("2_layer_script")]([SubResource("Layer_main")])
base_value = 16
spectrum_start = 0.775
spectrum_end = 0.805
base_quality = 1.05
