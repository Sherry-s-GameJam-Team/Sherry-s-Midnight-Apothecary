[resource]
script = ExtResource("1_ingredient_script")
id = &"eyrie_nest_seed_ball"
display_name = "崖巢抱籽草"
english_name = "Eyrie-Nest Seed-Ball"
description = "层叠叶片围成巢状球体，中央种籽含有温和的抗炎性粉末。"
lore = "高崖居民把完整籽球挂在屋檐下晾干；种籽脱落的方向常被用来判断迁徙鸟群何时归巢。"
icon = ExtResource("4_icon")
preview_texture = ExtResource("5_preview")
reference_canvas_size = Vector2i(4096, 4096)
production_layers = Array[ExtResource("2_layer_script")]([SubResource("Layer_main")])
base_value = 17
spectrum_start = 0.33
spectrum_end = 0.36
base_quality = 1.05
