[resource]
script = ExtResource("1_ingredient_script")
id = &"egg_climbers_honey_pot"
display_name = "采卵人的蜜壶掌"
english_name = "Egg-Climber’s Honey-Pot"
description = "花冠中的黏甜蜜液能够快速补充体力，厚实基部则含有持久的暖性成分。"
lore = "攀崖采卵人会在返程前割开花冠吮吸蜜液，因此把这种生在岩石上的巨型植株称作随身蜜壶。"
icon = ExtResource("4_icon")
preview_texture = ExtResource("5_preview")
reference_canvas_size = Vector2i(4096, 4096)
production_layers = Array[ExtResource("2_layer_script")]([SubResource("Layer_main")])
base_value = 22
spectrum_start = 0.400
spectrum_end = 0.430
base_quality = 1.1
base_concentration = 1.2

