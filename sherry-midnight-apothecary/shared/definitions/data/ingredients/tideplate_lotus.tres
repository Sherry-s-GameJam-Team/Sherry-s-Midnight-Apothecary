[resource]
script = ExtResource("1_ingredient")
id = &"tideplate_lotus"
display_name = "汐盘荷"
english_name = "Tideplate Lotus"
description = "层叠叶盘能聚住潮汐露水，研磨后带来柔和、均匀的青色药性。"
lore = "港湾浅滩的潮线每日留下细盐，汐盘荷会把盐分隔在最外层叶缘，只让清甜露水流向花心。"
icon = ExtResource("4_icon")
preview_texture = ExtResource("5_preview")
reference_canvas_size = Vector2i(4096, 4096)
production_layers = Array[ExtResource("2_layer")]([SubResource("Layer_main")])
base_value = 20
spectrum_start = 0.635
spectrum_end = 0.665
base_quality = 1.15
