[resource]
script = ExtResource("1_ingredient_script")
id = &"vesper_blue_thicket"
display_name = "晚祷蓝荆"
english_name = "Vesper Blue-Thicket"
description = "深蓝叶片带有强烈回甘，热泡后能帮助冻僵的四肢恢复知觉。"
lore = "雪山隘口的修道士在石墙边栽种蓝荆。它入冬后转为紫黑色，老叶与干浆果制成的高山黑茶是旅人的暖身饮。"
icon = ExtResource("4_icon")
preview_texture = ExtResource("5_preview")
reference_canvas_size = Vector2i(4096, 4096)
production_layers = Array[ExtResource("2_layer_script")]([SubResource("Layer_main")])
base_value = 20
spectrum_start = 0.815
spectrum_end = 0.845
base_quality = 1.1
base_concentration = 1.05
