[resource]
script = ExtResource("1_script")
id = &"praise_star_maple"
display_name = "礼赞五角槭"
english_name = "Praise-Star Maple"
description = "高大乔木结出带有天然绳结的五角星果。果壳可压榨出微甜清油，用于点亮乡村粗油灯；果肉可碾碎压成小方块，为浓汤增稠调味。"
lore = "中世纪平民相信果实上的绳结是“大地母亲打好的包装”。每年秋收节，村里的教士会带领村民来到树下，摘下第一批带绳星果挂在教堂门口祈福。"
icon = ExtResource("3_icon")
preview_texture = ExtResource("4_preview")
reference_canvas_size = Vector2i(4096, 4096)
production_layers = Array[ExtResource("2_layer_script")]([ExtResource("5_fruit")])
base_value = 18
spectrum_start = 0.1
spectrum_end = 0.25
base_quality = 1.05
base_concentration = 1.12
