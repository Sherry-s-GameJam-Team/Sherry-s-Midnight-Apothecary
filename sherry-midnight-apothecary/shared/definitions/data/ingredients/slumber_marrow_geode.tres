[resource]
script = ExtResource("1_ingredient_script")
id = &"slumber_marrow_geode"
display_name = "眠谷梦髓晶洞"
english_name = "Slumber-Marrow Geode"
description = "灰黑岩壳包裹着深紫晶髓，细碎晶渣可用于安眠与缓解神经痛。"
lore = "矿工把岩石内部的结晶称为梦髓。富裕者将原石置于床头驱散梦魇，平民则把少量晶渣浸入蜂蜜水。"
icon = ExtResource("4_icon")
preview_texture = ExtResource("5_preview")
reference_canvas_size = Vector2i(4096, 4096)
production_layers = Array[ExtResource("2_layer_script")]([SubResource("Layer_main")])
