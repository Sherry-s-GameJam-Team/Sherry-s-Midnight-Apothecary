[resource]
script = ExtResource("1_ingredient_script")
id = &"chalice_ice_spire"
display_name = "圣水冻蓝草"
english_name = "Chalice-Ice Spire"
description = "冰蓝色星形花簇中凝结着圣水般清澈的寒露，可用于净化与驱散污秽。"
lore = "雪山礼拜堂会在祝圣水源旁栽种此草；采药人相信花尖结冰而根茎不冻，是圣水仍在呼吸的证明。"
icon = ExtResource("4_icon")
preview_texture = ExtResource("5_preview")
reference_canvas_size = Vector2i(4096, 4096)
production_layers = Array[ExtResource("2_layer_script")]([SubResource("Layer_main")])
base_value = 18
spectrum_start = 0.735
spectrum_end = 0.765
base_quality = 1.15
base_concentration = 1.1

