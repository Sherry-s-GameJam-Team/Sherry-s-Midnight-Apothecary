[resource]
script = ExtResource("1_ingredient")
id = &"returning_tide_thorn_fern"
display_name = "回潮棘蕨"
english_name = "Returning-Tide Thorn Fern"
description = "叶脉会在潮气回升时泛起青光的棘蕨，适合稳定清凉而持续的药性。"
lore = "海雾退去后，岩缝里的棘蕨会把夜间凝结的水珠送回叶尖；渔民以此判断回潮将至。"
icon = ExtResource("4_icon")
preview_texture = ExtResource("5_preview")
reference_canvas_size = Vector2i(4096, 4096)
production_layers = Array[ExtResource("2_layer")]([SubResource("Layer_main")])
base_value = 18
spectrum_start = 0.595
spectrum_end = 0.625
base_quality = 1.05
base_concentration = 1.1
