[resource]
script = ExtResource("1_ingredient_script")
id = &"stagnant_breeze_bell_vine"
display_name = "滞风紫铃藤"
english_name = "Stagnant-Breeze Bell-Vine"
description = "垂落的紫色花串会吸收周围声响，使药液带有镇静与隔绝感官的性质。"
lore = "传说眠谷的风经过花串时声音会被完全吸收。旅人喜欢在紫铃藤覆盖的树下露宿，以避开夜行猛兽的咆哮。"
icon = ExtResource("4_icon")
preview_texture = ExtResource("5_preview")
reference_canvas_size = Vector2i(4096, 4096)
production_layers = Array[ExtResource("2_layer_script")]([SubResource("Layer_main")])
base_value = 21
spectrum_start = 0.915
spectrum_end = 0.945
base_quality = 1.15
base_concentration = 1.05

