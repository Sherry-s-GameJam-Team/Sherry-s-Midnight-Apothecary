[resource]
script = ExtResource("1_ingredient_script")
id = &"wind_cutter_rye"
display_name = "索道截风麦"
english_name = "Wind-Cutter Rye"
description = "坚韧麦秆能在索道强风中直立，研磨后可提供稳定而集中的黄色药性。"
lore = "索道看守人会把麦秆编进缆绳护套。它迎风时叶缘如刀，却能替附近作物截断最猛烈的侧风。"
icon = ExtResource("4_icon")
preview_texture = ExtResource("5_preview")
reference_canvas_size = Vector2i(4096, 4096)
production_layers = Array[ExtResource("2_layer_script")]([SubResource("Layer_main")])
base_value = 16
spectrum_start = 0.365
spectrum_end = 0.395
base_quality = 1.0
base_concentration = 1.15

