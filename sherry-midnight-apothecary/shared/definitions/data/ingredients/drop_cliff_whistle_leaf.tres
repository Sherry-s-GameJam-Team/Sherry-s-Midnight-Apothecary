[resource]
script = ExtResource("1_ingredient_script")
id = &"drop_cliff_whistle_leaf"
display_name = "坠鸟哨叶"
english_name = "Drop-Cliff Whistle-Leaf"
description = "悬崖边的金黄长叶会在强风中发出尖细哨声，叶脉富含镇痛性的暖光汁液。"
lore = "山路向导用哨叶判断崖口风向，也会将干叶卷成小哨，在浓雾中向同行者报位。"
icon = ExtResource("4_icon")
preview_texture = ExtResource("5_preview")
reference_canvas_size = Vector2i(4096, 4096)
production_layers = Array[ExtResource("2_layer_script")]([SubResource("Layer_main")])
base_value = 14
spectrum_start = 0.295
spectrum_end = 0.325
base_concentration = 0.95
