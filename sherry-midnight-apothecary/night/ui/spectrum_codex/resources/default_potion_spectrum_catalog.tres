[resource]
script = ExtResource("4_cat")
bands = Array[ExtResource("1_band")]([SubResource("Band_Red"), SubResource("Band_Orange"), SubResource("Band_Yellow"), SubResource("Band_Green"), SubResource("Band_Cyan"), SubResource("Band_Blue"), SubResource("Band_Purple")])
functions = Array[ExtResource("2_func")]([SubResource("Func_Hemostasis"), SubResource("Func_Circulation"), SubResource("Func_VigorBoost"), SubResource("Func_MuscleActive"), SubResource("Func_Analgesia"), SubResource("Func_AntiInflam"), SubResource("Func_TissueRepair"), SubResource("Func_CellRegrowth"), SubResource("Func_Cooling"), SubResource("Func_FluxStabilize"), SubResource("Func_Detox"), SubResource("Func_Dispel"), SubResource("Func_MindCalm"), SubResource("Func_SpiritFocus")])
recipes = Array[ExtResource("3_rec")]([SubResource("Rec_BloodPaste"), SubResource("Rec_DeepClot"), SubResource("Rec_WarmPulse"), SubResource("Rec_VitalityDraft"), SubResource("Rec_TigerEssence"), SubResource("Rec_NumbDrop"), SubResource("Rec_GoldenSalve"), SubResource("Rec_MossBalm"), SubResource("Rec_EmeraldDew"), SubResource("Rec_FrostMist"), SubResource("Rec_TranquilCrystal"), SubResource("Rec_PureDrop"), SubResource("Rec_HolyTide"), SubResource("Rec_DreamNectar"), SubResource("Rec_AstralClarity")])
matrix_row_labels = Array[String](["止血 (Red)", "活化 (Orange)", "镇痛 (Yellow)", "修复 (Green)", "降温 (Cyan)", "净化 (Blue)", "镇静 (Purple)"])
matrix_col_labels = Array[String](["止血", "循环", "体力", "抗炎", "再生", "稳定", "驱邪"])
