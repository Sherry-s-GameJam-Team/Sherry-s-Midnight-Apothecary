[sub_resource type="Resource" id="Band_Red"]
script = ExtResource("1_band")
id = &"band_red"
display_name = "红光波段 · 赤绯"
color = Color(0.85, 0.26, 0.21, 1)
spectrum_max = 0.1428
primary_effect_name = "止血、循环"
description = "红光波段主掌血液与脉络涌动。高浓度赤色药液能迅速收敛创口或加速体内微循环。"

[sub_resource type="Resource" id="Band_Orange"]
